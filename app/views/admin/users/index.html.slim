main.mdl-layout__content.mdl-color--grey-100
  .stretch.page-content
    h4 後台使用者管理
    = search_form_for @user_q, url: admin_users_path do |f|
      = f.search_field :name_or_email_cont, placeholder: '輸入姓名或 Email'
      = f.submit '搜尋', class: 'mdl-button mdl-js-button'
    table.mdl-data-table.mdl-js-data-table.mdl-color--white.mdl-shadow--2dp.jrf-result-table
      thead
        tr
          th 姓名
          th E-mail
          th 來源（Google／Facebook）
          th 當前權限
          th 權限管理
      tbody
        - @users.each do |u|
          tr
            td = u.name.presence || '未提供'
            td = u.email
            td
              - if u.provider == 'google_oauth2'
                | Google
              - elsif u.provider == 'facebook'
                | Facebook
              - else
                | 未知
            td = u.admin? ? '管理員' : '無'
            td
              - if u == current_user
                | （目前登入帳號）
              - else
                = button_to (u.admin? ? '移除管理權限' : '授與管理權限'), admin_user_path(u), method: :patch, params: { 'user[admin]' => (u.admin? ? 0 : 1) }, class: 'mdl-button mdl-js-button mdl-button--colored'
                = button_to '刪除', admin_user_path(u), method: :delete, data: { confirm: "確認要刪除 #{u.email} 嗎？" }, class: 'mdl-button mdl-js-button'

    nav.pagination
      = paginate @users
